# Environment variables for AI Service
# Copy to .env and fill in actual values

# Flask
FLASK_ENV=production
AI_PORT=5000

# Groq API
GROQ_API_KEY=your-groq-api-key-here

# Redis (caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ChromaDB
CHROMA_DATA_DIR=./chroma_data

# Logging
LOG_LEVEL=INFO
